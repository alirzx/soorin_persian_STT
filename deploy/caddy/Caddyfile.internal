{
    admin off
    skip_install_trust
    auto_https disable_redirects
}
# Private-IP mode; client OS/browser must trust Caddy's internal CA.
https://{$STT_HTTPS_HOST}:8443 {
    tls internal
    import /etc/caddy/auth.{$STT_AUTH_MODE}.caddy

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Permissions-Policy "microphone=(self)"
    }

    @private_api path /api/metrics /api/docs /api/redoc /api/openapi.json
    respond @private_api 404

    reverse_proxy stt-ui:80 {
        header_up -Authorization
        stream_timeout 15m
    }
}
