# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

APP_API_KEY=
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_INFERENCE_CONCURRENCY=1
APP_REQUEST_TIMEOUT_SECONDS=120

# Primary model
STT_MODEL=shenava-koochik

STT_BACKEND=
STT_MODEL_ID=
STT_MODEL_REVISION=

STT_MODEL_DIR=./models/downloads
STT_CATALOG_DIR=./configs/models

# CPU runtime
STT_DEVICE=cpu
STT_COMPUTE_TYPE=auto
STT_CPU_THREADS=4

# Model safety
STT_OFFLINE=true
STT_REQUIRE_MODEL_PIN=true
STT_VERIFY_HASHES=true
STT_WARMUP=true
STT_ALLOW_NONCOMMERCIAL=false

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_SECONDS=600

# Streaming
STREAM_MAX_SESSIONS=2
STREAM_QUEUE_MAX_FRAMES=64
STREAM_MAX_FRAME_BYTES=65536
STREAM_PARTIAL_INTERVAL_MS=300

STREAM_MAX_SECONDS=600
STREAM_IDLE_TIMEOUT_SECONDS=60

# VAD
VAD_ENABLED=true
VAD_MIN_SPEECH_MS=180
VAD_MIN_SILENCE_MS=550
VAD_RMS_THRESHOLD=0.006

# Persian text
TEXT_NORMALIZE=true
TEXT_ITN=false
TEXT_DOMAIN=general

# Observability
LOG_LEVEL=INFO
LOG_AUDIO=false
METRICS_ENABLED=true
# Hardening: inference slots are held until the native worker actually finishes
APP_SLOT_WAIT_SECONDS=10
# Bounded pseudo-streaming (Shenava offline CTC)
STREAM_WINDOW_MAX_SECONDS=8
STREAM_PARTIAL_MIN_AUDIO_SECONDS=1.2
STREAM_PARTIAL_DECODE_INTERVAL_SECONDS=3

STREAM_PARTIAL_MAX_QUEUED_FRAMES=8

# Docker deployment: loopback ports, optional studio, shared internal bridge.
# Do not expose these ports publicly; internal consumers use the Docker network.
STT_BIND_HOST=127.0.0.1
UI_BIND_HOST=127.0.0.1
UI_PORT=3015
SOORIN_STT_NETWORK=soorin-ai
DOCKER_STT_CPUS=4.0
DOCKER_STT_MEMORY_LIMIT=3g
DOCKER_STT_MEMORY_SWAP_LIMIT=3g

# Optional HTTPS gateway for LAN/VPN browsers.
# STT_HTTPS_HOST is the browser hostname / TLS certificate SAN.
# STT_HTTPS_BIND_HOST selects the host LAN/VPN interface, NOT the TLS identity.
STT_HTTPS_HOST=localhost
STT_HTTPS_BIND_HOST=127.0.0.1
STT_HTTPS_PORT=3443
# internal: Caddy-managed CA, each client must trust it.
# files: mount an externally issued cert (e.g. domain + DNS-01 certificate).
STT_TLS_MODE=internal
# Relative to deploy/compose.yaml. In files mode this directory must contain
# fullchain.pem and privkey.pem. Keep these outside Git.
STT_TLS_CERT_DIR=../certs
# none: no shared password; restrict network via VPN/host firewall or upstream ACLs.
# basic: optional login for environments that require it.
STT_AUTH_MODE=none
STT_HTTPS_USER=
STT_HTTPS_PASSWORD_HASH=
